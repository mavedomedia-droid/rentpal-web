/* SCORE */
function renderScore(){
  stepsEl.innerHTML = `<div class="step active"><div class="loading"><div class="spin"></div>Crunching your numbers…</div></div>`;
  fetchScore().then(res=>{
    scoreResult = res;
    track('rentpal_score_complete', { rentpal_score: res.score, rentpal_band: res.band });
    paintScore(res);
  }).catch(()=>{ scoreResult = localEstimate(); paintScore(scoreResult); });
}

function fetchScore(){
  const qs = new URLSearchParams({
    action:'score',
    areaRaw: vals.areaRaw||'', aptType: vals.aptType||'', rentYearly: vals.rentYearly||'',
    light: vals.light||'', water: vals.water||'', parking: vals.parking||'', security: vals.security||''
  });
  if(!GAS_URL || GAS_URL.indexOf('PASTE_')===0) return Promise.resolve(localEstimate());
  return jsonp(`${GAS_URL}?${qs.toString()}`).then(r => (r && r.result) ? r.result : localEstimate());
}

function jsonp(url){
  return new Promise((resolve,reject)=>{
    const cb='rp_cb_'+Date.now();
    const t=setTimeout(()=>{cleanup();reject();},9000);
    function cleanup(){ clearTimeout(t); delete window[cb]; s.remove(); }
    window[cb]=function(data){ cleanup(); resolve(data); };
    const s=document.createElement('script');
    s.src=url+(url.indexOf('?')>-1?'&':'?')+'callback='+cb;
    s.onerror=function(){ cleanup(); reject(); };
    document.body.appendChild(s);
  });
}

function localEstimate(){
  const q = {'band a':30,'band b':23,'band c':15,'band d':8,'no light':0}[(vals.light||'').toLowerCase()]||0;
  const score = Math.max(20, Math.min(95, 55 + q - 10));
  return { score, percentile:50, band: scoreBand(score), confidence:'Provisional', benchmarkMedian:null, areaCanonical: vals.areaRaw };
}
function scoreBand(s){ return s>=80?'Great value':s>=60?'Fair':s>=40?'Slightly high':'Overpaying'; }

function paintScore(r){
  const bandStr = r.band||'';
  const pct = r.score==null ? 0 : r.score;
  const circ = 2*Math.PI*76;
  const off = circ - (pct/100)*circ;
  const col = pct>=80?'#2B7A4B':pct>=60?'#2B6F9C':pct>=40?'#E8B23A':'#E5634D';

  let pctLine = '';
  if(r.score!=null && typeof r.percentile==='number' && vals.aptType && vals.areaRaw){
    const p = Math.round(r.percentile);
    const soft = r.confidence==='Provisional' ? 'Based on early data — ' : '';
    if(p <= 50) pctLine = `<div class="pctline">${soft}you pay less than <b>${100-p}%</b> of similar ${vals.aptType.toLowerCase()}s in ${vals.areaRaw}.</div>`;
    else        pctLine = `<div class="pctline">${soft}you pay more than <b>${p}%</b> of similar ${vals.aptType.toLowerCase()}s in ${vals.areaRaw}.</div>`;
  }

  stepsEl.innerHTML = `
    <div class="step active score-wrap">
      <div class="step-eyebrow">Your RentPal Score</div>
      <div class="ring">
        <svg width="172" height="172">
          <circle cx="86" cy="86" r="76" stroke="#e0e0e0" stroke-width="11" fill="none"/>
          <circle cx="86" cy="86" r="76" stroke="${col}" stroke-width="11" fill="none" stroke-linecap="round"
                  stroke-dasharray="${circ}" stroke-dashoffset="${circ}" id="ringFill"/>
        </svg>
        <div class="val"><div class="num" id="scoreNum">${r.score==null?'—':'0'}</div><div class="of">out of 100</div></div>
      </div>
      <div class="band" style="color:${col}">${bandStr}</div>
      ${pctLine}
      ${r.confidence?`<div class="conf">Confidence: ${r.confidence}${r.confidence==='Provisional'?' · sharpens as more neighbours join':''}</div>`:''}
      <div class="qnav" style="justify-content:center;margin-top:28px">
        <button class="next-btn prominent" onclick="next()">📬 Save my score & get area alerts →</button>
      </div>
    </div>`;

  if(r.score!=null){
    requestAnimationFrame(()=>{ const e=document.getElementById('ringFill'); if(e){e.style.transition='stroke-dashoffset 1.1s ease';e.style.strokeDashoffset=off;} });
    let n=0; const el=document.getElementById('scoreNum');
    const iv=setInterval(()=>{ n+=Math.max(1,Math.ceil(r.score/24)); if(n>=r.score){n=r.score;clearInterval(iv);} el.textContent=n; },28);
  }
}

/* CONTACT */
function renderContact(){
  stepsEl.innerHTML = `
    <div class="step active">
      <div class="step-eyebrow">Stay in the loop</div>
      <div class="qtitle">Keep your score & get alerts 📬</div>
      <p class="qhint">We'll save your results and let you know when rents move in your area. No spam, ever.</p>
      <div class="field"><label>Name</label><input class="input" id="c_name" placeholder="Your name" value="${vals.name||''}"></div>
      <div class="field"><label>Email</label><input class="input" id="c_email" type="email" inputmode="email" placeholder="you@email.com" value="${vals.email||''}"></div>
      <div class="field"><label>Phone</label><input class="input" id="c_phone" type="tel" inputmode="tel" placeholder="080…" value="${vals.phone||''}"></div>
      <div class="field"><label>Telegram <span style="text-transform:none;color:var(--ink-light);letter-spacing:0">(optional, e.g. @username or 080…)</span></label><input class="input" id="c_tg" placeholder="@username" value="${vals.telegram||''}"></div>

      <label class="toggle"><input type="checkbox" id="c_dir" checked>
        <div><span class="ttl">Share anonymously</span><span class="sub">Your data helps sharpen area benchmarks — your identity is never revealed.</span></div></label>
      <label class="toggle"><input type="checkbox" id="c_intro" checked>
        <div><span class="ttl">Get notified if someone wants to ask about your area/house</span><span class="sub">We will never share your contact automatically. You always decide.</span></div></label>

      <div class="qnav"><button class="back-btn" onclick="back()">← Back</button><button class="next-btn" id="submitBtn" onclick="submitAll()">Save & finish →</button></div>
    </div>`;
}

function submitAll(){
  const name=(document.getElementById('c_name').value||'').trim();
  const email=(document.getElementById('c_email').value||'').trim();
  if(!name || !email){ alert('Add your name and email so we can send your breakdown.'); return; }
  vals.name=name; vals.email=email;
  vals.phone=(document.getElementById('c_phone').value||'').trim();
  vals.telegram=(document.getElementById('c_tg').value||'').trim().replace(/^@/,'');
  const parts=name.split(' ');

  const payload = {
    action:'submit',
    mainlandIsland: vals.mainlandIsland||'', areaRaw: vals.areaRaw||'', busStop: vals.busStop||'',
    aptType: vals.aptType||'', rentYearly: vals.rentYearly||'', serviceCharge: vals.serviceCharge||'0',
    otherFees:'0', light: vals.light||'', water: vals.water||'', parking: vals.parking||'',
    security: vals.security||'', condition: vals.condition||'', buildingSize: vals.buildingSize||'',
    timeAtAddress: vals.timeAtAddress||'', housingIntent: vals.housingIntent||'',
    firstName: parts[0]||'', lastName: parts.slice(1).join(' '),
    email: vals.email, phone: vals.phone, telegram: vals.telegram,
    consentScore: true,
    consentDirectory: document.getElementById('c_dir').checked,
    consentIntroductions: document.getElementById('c_intro').checked
  };

  const btn=document.getElementById('submitBtn'); btn.disabled=true; btn.textContent='Sending…';
  track('rentpal_lead_complete', { rentpal_score: scoreResult ? scoreResult.score : null });

  if(GAS_URL && GAS_URL.indexOf('PASTE_')!==0){
    fetch(GAS_URL, { method:'POST', mode:'no-cors', headers:{'Content-Type':'text/plain;charset=utf-8'},
      body: JSON.stringify(payload) }).then(goThanks).catch(goThanks);
  } else { goThanks(); }
}
function goThanks(){ idx = STEPS.findIndex(s=>s.id==='thanks'); render(); document.getElementById('quizSection').scrollIntoView({behavior:'smooth'}); }

function renderThanks(){
  const r = scoreResult||{};
  const rent = Number(vals.rentYearly||0);
  const med = r.benchmarkMedian;
  const fmt = n => '₦'+Number(n||0).toLocaleString();
  let compare = '';
  if(med){
    const diff = rent-med, pctDiff = med?Math.round((diff/med)*100):0;
    compare = `<div class="bd">
      <div class="row"><span>Typical for ${vals.aptType} in ${r.areaCanonical||vals.areaRaw}</span><b>${fmt(med)}</b></div>
      <div class="row"><span>You pay</span><b>${fmt(rent)}</b></div>
      <div class="row"><span>${diff>0?'Above':'Below'} typical</span><b style="color:${diff>0?'var(--bad)':'var(--good)'}">${diff>0?'+':''}${pctDiff}%</b></div></div>`;
  }
  stepsEl.innerHTML = `
    <div class="step active">
      <div class="ty-card">
        <h3>All set ✅</h3>
        <p class="ty-recap">RentPal Score: <b>${r.score??'—'}</b> · ${r.band||''}</p>
        ${compare}
        <div class="ty-next">
          <div class="ty-next-lbl">What happens next</div>
          <div class="ty-row"><span class="ty-check">✓</span><span>Your score has been saved.</span></div>
          <div class="ty-row"><span class="ty-check">✓</span><span>We'll send the full breakdown to your email.</span></div>
          <div class="ty-row"><span class="ty-check">✓</span><span>Your data remains private — only anonymous aggregates are used.</span></div>
          <div class="ty-row"><span class="ty-check">✓</span><span>If someone asks about your area, we'll notify you first.</span></div>
        </div>
        <p class="alerts-note">📬 Alerts will be sent to your email and phone if you provided them.</p>
      </div>
    </div>`;
  qpfill.style.width='100%';
}

function esc(s){ return String(s).replace(/'/g,"\\'").replace(/"/g,'&quot;'); }
function fireStartOnce(){ if(!started){ started=true; track('rentpal_quiz_start'); } }
function next(){ if(idx<STEPS.length-1){ idx++; render(); document.getElementById('quizSection').scrollIntoView({behavior:'smooth',block:'start'}); } }
function back(){ if(idx>0){ idx--; render(); document.getElementById('quizSection').scrollIntoView({behavior:'smooth',block:'start'}); } }
</script>
</body>
</html>
