}

function render(){
  const s = STEPS[idx];
  const pct = Math.round((idx/(STEPS.length-1))*100);
  qpfill.style.width = pct+'%';
  qplabel.textContent = s.type==='thanks' ? 'Done ✓' : (s.eyebrow ? s.eyebrow.split('·')[1]?.trim()||'' : '');

  if(s.type==='where')   return renderWhere(s);
  if(s.type==='choice')  return renderChoice(s);
  if(s.type==='money')   return renderMoney(s);
  if(s.type==='group')   return renderGroup(s);
  if(s.type==='score')   return renderScore();
  if(s.type==='contact') return renderContact();
  if(s.type==='thanks')  return renderThanks();
}

function header(s){
  return `<div class="step-eyebrow">${s.eyebrow||''}</div><div class="qtitle">${s.title||''}</div>`;
}

function renderWhere(s){
