let idx = 0, started = false, scoreResult = null;
const vals = {};
const stepsEl = document.getElementById('steps');
const qpfill  = document.getElementById('qpfill');
const qplabel = document.getElementById('qplabel');

function toggleMenu(){ document.getElementById('mobile-menu').classList.toggle('open'); }
function closeMenu(){  document.getElementById('mobile-menu').classList.remove('open'); }

function startQuiz(){
  document.getElementById('hero').style.display = 'none';
  document.getElementById('quizSection').classList.add('active');
  idx = 0; render();
