      </div>
      <div class="field">
        <label>Area</label>
        <select class="select" id="area-sel" ${!loc?'disabled':''} onchange="onAreaPick(this.value)">
          <option value="">${loc?'Choose your area':'Pick Mainland or Island first'}</option>
          ${areas.map(a=>`<option value="${a}" ${areaSel===a?'selected':''}>${a}</option>`).join('')}
          ${loc?`<option value="__other__" ${isOther?'selected':''}>Other (type it)</option>`:''}
        </select>
      </div>
      ${isOther?`<div class="field"><label>Type your area</label><input class="input" id="area-other" placeholder="e.g. somewhere specific" value="${vals.areaRawOther||''}" oninput="vals.areaRawOther=this.value;refreshNext()"></div>`:''}
      <div class="field">
        <label>Nearest bus stop or landmark <span style="text-transform:none;color:var(--ink-light);letter-spacing:0">(optional)</span></label>
        <input class="input" id="busstop" placeholder="e.g. Sabo, Allen junction" value="${vals.busStop||''}" oninput="vals.busStop=this.value">
      </div>
      <div class="qnav"><span></span><button class="next-btn" id="nextBtn" onclick="continueWhere()" ${whereOk()?'':'disabled'}>Continue →</button></div>
    </div>`;
}
function setLoc(loc){ fireStartOnce(); vals.mainlandIsland = loc; vals.areaRaw = ''; vals.areaRawOther = ''; renderWhere(STEPS[idx]); }
function onAreaPick(v){ vals.areaRaw = v; renderWhere(STEPS[idx]); }
function whereOk(){ if(!vals.mainlandIsland) return false; if(vals.areaRaw === '__other__') return !!(vals.areaRawOther||'').trim(); return !!vals.areaRaw; }
function refreshNext(){ const b=document.getElementById('nextBtn'); if(b) b.disabled = !whereOk(); }
function continueWhere(){ if(vals.areaRaw === '__other__') vals.areaRaw = vals.areaRawOther; next(); }

function renderChoice(s){
  stepsEl.innerHTML = `
    <div class="step active">
      ${header(s)}
      <div class="opts ${s.grid?'g2':''}">
        ${s.opts.map(o=>`<button class="opt ${vals[s.key]===o.v?'sel':''}" onclick="pickChoice('${s.key}','${esc(o.v)}')">
          <span class="em">${o.em||''}</span><span><span class="ttl">${o.v}</span></span></button>`).join('')}
      </div>
      <div class="qnav"><button class="back-btn" onclick="back()">← Back</button><span></span></div>
    </div>`;
}
function pickChoice(key,v){ fireStartOnce(); vals[key]=v; setTimeout(next,160); render(); }

/* MONEY SCREEN with formatted preview and +50k */
function formatNaira(num){
  if(!num || isNaN(num)) return '';
  return '₦' + parseInt(num).toLocaleString('en-NG');
}
function renderMoney(s){
  const rent = vals.rentYearly || '';
  const service = vals.serviceCharge || '';
  const chips = [600000,1200000,2000000,3500000];
  const eChips = [0,150000,400000];
  const preview = formatNaira(rent);
  stepsEl.innerHTML = `
    <div class="step active">
      ${header(s)}
      <div class="group">
        <div class="group-lbl">💸 Yearly rent (₦)</div>
        ${preview ? `<div class="rent-preview">${preview}</div>` : `<div class="rent-preview" style="color:var(--ink-light)">—</div>`}
        <div class="rent-input-row">
          <input class="input" id="rent" type="number" inputmode="numeric" placeholder="e.g. 1800000" value="${rent}" oninput="updateRent(this.value)">
          <button class="btn-inc" onclick="incRent()">+50k</button>
        </div>
        <div class="chips">${chips.map(c=>`<button class="chip" onclick="setRent(${c})">₦${c.toLocaleString()}</button>`).join('')}</div>
      </div>
      <div class="group">
        <div class="group-lbl">🧾 Any extra yearly charges? <span style="text-transform:none;letter-spacing:0;color:var(--ink-light);font-family:var(--body)">— service, estate dues, levies</span></div>
        <input class="input" id="extras" type="number" inputmode="numeric" placeholder="e.g. 200000 (or ₦0)" value="${service}" oninput="vals.serviceCharge=this.value">
        <div class="chips">${eChips.map(c=>`<button class="chip" onclick="setExtras(${c})">${c===0?'No extras':'₦'+c.toLocaleString()}</button>`).join('')}</div>
      </div>
      <div class="qnav"><button class="back-btn" onclick="back()">← Back</button><button class="next-btn" id="nextBtn" onclick="next()" ${rent?'':'disabled'}>Continue →</button></div>
    </div>`;
}
function updateRent(val){ vals.rentYearly=val; const el=document.querySelector('.rent-preview'); if(el) el.textContent=formatNaira(val)||'—'; refreshMoney(); }
function setRent(n){ fireStartOnce(); vals.rentYearly=String(n); const inp=document.getElementById('rent'); if(inp) inp.value=n; updateRent(n); }
function incRent(){ let v=parseInt(vals.rentYearly)||0; v+=50000; setRent(v); }
function setExtras(n){ fireStartOnce(); vals.serviceCharge=String(n); const el=document.getElementById('extras'); if(el) el.value=n; }
function refreshMoney(){ const b=document.getElementById('nextBtn'); if(b) b.disabled=!vals.rentYearly; }

function renderGroup(s){
  stepsEl.innerHTML = `
    <div class="step active">
      ${header(s)}
      ${s.groups.map(g=>`
        <div class="group">
          <div class="group-lbl"><span class="em">${g.label}</span>${g.hint?` <span style="text-transform:none;letter-spacing:0;color:var(--ink-light);font-family:var(--body)">— ${g.hint}</span>`:''}</div>
          <div class="opts">
            ${g.opts.map(o=>`<button class="opt ${vals[g.key]===o.v?'sel':''}" onclick="pickGroup('${g.key}','${esc(o.v)}')">
              <span class="em">${o.em||''}</span><span><span class="ttl">${o.v}</span>${o.sub?`<span class="sub">${o.sub}</span>`:''}</span></button>`).join('')}
