<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --ink:#1a1a1a; --ink-muted:#555; --ink-light:#888;
    --blue:#1E3A5F; --blue-light:#F0F4FA; --accent:#2B6F9C; --accent-hover:#1E4E6B;
    --white:#ffffff; --border:#e5e5e5; --radius:6px; --radius-lg:10px;
    --display:'Plus Jakarta Sans',sans-serif; --body:'DM Sans',sans-serif; --mono:'DM Mono',monospace;
    /* Softer dark charcoal — easy on the eyes */
    --dark-bg:#4B5258;
    --dark-text:#f5f5f5;
    --dark-border:#888;
  }
  html{scroll-behavior:smooth;font-size:16px}
  body{font-family:var(--body);color:var(--ink);background:var(--white);line-height:1.6;-webkit-font-smoothing:antialiased}

  /* NAV */
  nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:64px;background:rgba(255,255,255,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100}
  .nav-logo{font-family:var(--display);font-size:19px;font-weight:800;color:var(--blue);display:flex;align-items:center;gap:8px}
  .nav-logo img{height:26px}
  .nav-links{display:flex;align-items:center;gap:28px;list-style:none}
  .nav-links a{font-size:14px;color:var(--ink-muted);text-decoration:none;transition:color .2s}
  .nav-links a:hover{color:var(--ink)}
  .nav-cta{background:var(--accent);color:#fff;border:none;padding:9px 20px;border-radius:var(--radius);font-family:var(--body);font-size:14px;font-weight:500;cursor:pointer;text-decoration:none;transition:background .2s}
  .nav-cta:hover{background:var(--accent-hover)}
  .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px}
  .hamburger span{display:block;width:22px;height:2px;background:var(--ink);border-radius:2px}
  .mobile-menu{display:none;flex-direction:column;background:#fff;border-bottom:1px solid var(--border);padding:14px 20px 18px;gap:4px}
  .mobile-menu.open{display:flex}
  .mobile-menu a{font-size:15px;color:var(--ink-muted);text-decoration:none;padding:9px 0;border-bottom:1px solid var(--border)}
  .mobile-menu a:last-child{border:none}
  .mobile-menu .mob-cta{margin-top:8px;background:var(--accent);color:#fff;padding:12px 20px;border-radius:var(--radius);text-align:center;font-weight:500;border:none}

  /* HERO (intro CTA) */
  .hero-wrap{display:flex;flex-direction:column;align-items:center;text-align:center;padding:72px 24px 48px}
  .hero-content{max-width:560px}
  .hero-tag{display:inline-flex;align-items:center;gap:8px;background:var(--blue-light);color:var(--blue);font-size:12px;font-weight:500;padding:5px 14px;border-radius:100px;margin-bottom:20px;font-family:var(--mono)}
  .hero-title{font-family:var(--display);font-size:clamp(30px,6vw,44px);font-weight:800;line-height:1.08;letter-spacing:-1px;color:var(--ink);margin-bottom:14px}
  .hero-title em{font-style:normal;color:var(--accent)}
  .hero-desc{font-size:16px;font-weight:300;color:var(--ink-muted);line-height:1.6;margin-bottom:24px}
  .hero-reassure{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;color:var(--ink-light);font-size:13px;font-family:var(--mono);margin-bottom:28px}
  .btn-start{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;border:none;padding:14px 32px;border-radius:var(--radius);font-family:var(--display);font-size:16px;font-weight:600;cursor:pointer;text-decoration:none;transition:background .2s,transform .15s;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
  .btn-start:hover{background:var(--accent-hover);transform:translateY(-1px)}

  /* QUIZ SECTION */
  .quiz-section{display:none;background:#f9fafb;border-top:1px solid var(--border);padding:48px 24px 64px}
  .quiz-section.active{display:block}
  .quiz-container{max-width:600px;margin:0 auto}
  .qpwrap{display:flex;align-items:center;gap:12px;margin-bottom:24px}
  .qpbar{flex:1;height:4px;background:#e0e0e0;border-radius:4px;overflow:hidden}
  .qpfill{height:100%;background:var(--accent);border-radius:4px;width:0;transition:width .4s ease}
  .qplabel{font-family:var(--mono);font-size:11px;color:var(--ink-light);white-space:nowrap}

  .step{display:none;animation:fadeUp .28s ease both}
  .step.active{display:block}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .step-eyebrow{font-family:var(--mono);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:1px;color:var(--accent);margin-bottom:8px}
  .qtitle{font-family:var(--display);font-size:22px;font-weight:700;color:var(--ink);line-height:1.22;margin-bottom:6px;letter-spacing:-.3px}
  .qhint{font-size:14px;font-weight:300;color:var(--ink-muted);margin-bottom:18px;line-height:1.6}
  .group{margin-bottom:18px}
  .group-lbl{font-family:var(--mono);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.6px;color:var(--ink-muted);margin:18px 0 8px;display:flex;align-items:center;gap:7px}
  .group:first-child .group-lbl{margin-top:0}

  /* OPTIONS – bigger, lighter buttons */
  .opts{display:flex;flex-direction:column;gap:10px}
  .opts.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .opt{border:1px solid var(--dark-border);border-radius:var(--radius);padding:14px 20px;cursor:pointer;background:var(--dark-bg);text-align:left;font-family:var(--body);display:flex;align-items:center;gap:14px;width:100%;transition:all .15s}
  .opt:hover{border-color:var(--accent);background:#5A6167}
  .opt.sel{border-color:var(--accent);background:var(--accent);color:#fff}
  .opt .em{font-size:22px;line-height:1;flex:none}
  .opt .ttl{font-size:15px;font-weight:500;color:var(--dark-text);line-height:1.3}
  .opt.sel .ttl{color:#fff}
  .opt .sub{font-size:12px;font-weight:300;color:#ccc;margin-top:1px}
  .opt.sel .sub{color:rgba(255,255,255,0.8)}

  /* LIGHTER INPUTS */
  .field{margin-bottom:14px}
  .field label{display:block;font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-muted);margin-bottom:6px}
  .input,.select{width:100%;padding:12px 14px;border:1px solid var(--dark-border);border-radius:var(--radius);font-family:var(--body);font-size:16px;color:var(--dark-text);background:var(--dark-bg);outline:none;transition:border-color .15s}
  .input::placeholder{color:#bbb}
  .input:focus,.select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(43,111,156,0.2)}
  .select{appearance:none;-webkit-appearance:none;cursor:pointer;background-image:url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23bbb' stroke-width='1.6' fill='none' stroke-linecap='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 14px center;padding-right:38px}
  .select option{background:var(--dark-bg);color:var(--dark-text)}

  /* RENT PREVIEW */
  .rent-preview{font-family:var(--display);font-size:28px;font-weight:700;text-align:center;color:var(--ink);margin-bottom:8px;min-height:40px}
  .rent-input-row{display:flex;align-items:center;gap:8px}
  .rent-input-row .input{flex:1}
  .btn-inc{background:var(--accent);color:#fff;border:none;padding:12px 16px;border-radius:var(--radius);font-family:var(--body);font-weight:600;font-size:16px;cursor:pointer;white-space:nowrap;transition:background .2s}
  .btn-inc:hover{background:var(--accent-hover)}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .chip{font-family:var(--mono);font-size:12px;color:var(--dark-text);background:#5A6167;border:1px solid var(--dark-border);border-radius:var(--radius);padding:6px 14px;cursor:pointer;transition:all .15s}
  .chip:hover{background:#6A7278;border-color:var(--accent)}

  /* TOGGLE PILLS (lighter) */
  .toggle-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}
  .toggle-pill{border:1px solid var(--dark-border);border-radius:var(--radius);padding:14px 20px;cursor:pointer;background:var(--dark-bg);text-align:center;font-family:var(--body);font-size:15px;font-weight:500;color:var(--dark-text);display:flex;align-items:center;justify-content:center;gap:8px;transition:all .15s}
  .toggle-pill:hover{border-color:var(--accent);background:#5A6167}
  .toggle-pill.sel{background:var(--accent);border-color:var(--accent);color:#fff}

  .qnav{display:flex;justify-content:space-between;align-items:center;margin-top:24px;gap:10px}
  .back-btn{background:none;border:none;color:var(--ink-muted);font-family:var(--body);font-size:13px;cursor:pointer;padding:8px 4px}
  .back-btn:hover{color:var(--ink)}
  .next-btn{font-family:var(--body);font-weight:600;font-size:15px;color:#fff;background:var(--accent);border:none;border-radius:var(--radius);padding:13px 28px;cursor:pointer;transition:background .2s}
  .next-btn:hover{background:var(--accent-hover)}
  .next-btn:disabled{opacity:.4;cursor:not-allowed}
  .next-btn.prominent{padding:16px 32px;font-size:17px;font-family:var(--display);font-weight:700}

  /* SCORE */
  .score-wrap{text-align:center;padding:8px 0}
  .ring{position:relative;width:172px;height:172px;margin:6px auto 14px}
  .ring svg{transform:rotate(-90deg)}
  .ring .val{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .ring .num{font-family:var(--display);font-weight:800;font-size:50px;line-height:1;color:var(--ink)}
  .ring .of{font-family:var(--mono);font-size:11px;color:var(--ink-muted);margin-top:3px}
  .band{font-family:var(--display);font-weight:700;font-size:21px;margin:4px 0 10px}
  .verdict{color:var(--ink-muted);font-size:15px;max-width:380px;margin:0 auto 8px;line-height:1.55}
  .conf{font-family:var(--mono);font-size:11px;color:var(--ink-light);margin-top:12px}
  .pctline{font-size:13px;color:var(--ink-muted);margin-top:8px;font-weight:300}
  .pctline b{color:var(--ink);font-weight:500}
  .spin{width:36px;height:36px;border:3px solid #e0e0e0;border-top-color:var(--accent);border-radius:50%;margin:0 auto 14px;animation:rot 1s linear infinite}
  @keyframes rot{to{transform:rotate(360deg)}}
  .loading{padding:50px 0;text-align:center;color:var(--ink-muted);font-family:var(--mono);font-size:13px}

  /* CONSENT (lighter) */
  .toggle{display:flex;align-items:flex-start;gap:11px;background:var(--dark-bg);border:1px solid var(--dark-border);border-radius:var(--radius);padding:14px 16px;margin-bottom:10px;cursor:pointer;transition:border-color .15s}
  .toggle:hover{border-color:var(--accent)}
  .toggle input{margin-top:3px;width:18px;height:18px;accent-color:var(--accent);flex:none}
  .toggle .ttl{font-size:13.5px;color:var(--dark-text);font-weight:500}
  .toggle .sub{display:block;color:#ccc;font-size:12px;font-weight:300;margin-top:3px;line-height:1.5}

  /* THANKS */
  .ty-card{background:#fff;border:1px solid #eee;border-radius:var(--radius-lg);padding:28px 24px;text-align:center}
  .ty-card h3{font-family:var(--display);font-size:22px;font-weight:700;color:var(--ink);margin-bottom:6px}
  .ty-recap{font-size:15px;color:var(--ink-muted);margin-bottom:14px}
  .ty-recap b{color:var(--ink)}
  .bd{background:#f9f9f9;border:1px solid #eee;border-radius:var(--radius);padding:14px 16px;margin:16px 0;text-align:left}
  .bd .row{display:flex;justify-content:space-between;font-size:14px;padding:7px 0;border-bottom:1px dashed #ddd;color:var(--ink-muted)}
  .bd .row:last-child{border:none}
  .bd .row b{font-family:var(--mono);color:var(--ink)}
  .ty-next{background:#f9f9f9;border-radius:var(--radius);padding:14px 16px;text-align:left;margin:16px 0 20px;border:1px solid #eee}
  .ty-next-lbl{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--ink-light);margin-bottom:9px}
  .ty-row{display:flex;gap:9px;font-size:13px;font-weight:300;color:var(--ink-muted);line-height:1.55;margin-bottom:7px;align-items:flex-start}
  .ty-row:last-child{margin:0}
  .ty-check{color:var(--accent);flex:none;margin-top:1px}
  .alerts-note{font-size:14px;color:var(--ink-muted);margin-top:12px}

  /* TRUST BAR */
  .trust-bar{background:var(--blue-light);border-bottom:1px solid #dce6f0;padding:14px 48px;display:flex;align-items:center;justify-content:center;gap:36px;flex-wrap:wrap}
  .trust-item{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--blue)}
  .trust-em{font-size:15px}

  /* SECTIONS */
  .section{padding:80px 48px;max-width:1100px;margin:0 auto}
  .section-eyebrow{font-family:var(--mono);font-size:12px;font-weight:500;text-transform:uppercase;letter-spacing:1.2px;color:var(--accent);margin-bottom:10px}
  .section-title{font-family:var(--display);font-size:clamp(26px,4vw,34px);font-weight:700;letter-spacing:-.6px;color:var(--ink);margin-bottom:14px;line-height:1.15}
  .section-sub{font-size:15px;font-weight:300;color:var(--ink-muted);line-height:1.75;max-width:540px;margin-bottom:40px}

  .steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border-radius:var(--radius-lg);overflow:hidden}
  .stepcard{background:#fff;padding:30px 26px}
  .stepcard .num{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--accent);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .stepcard .num::before{content:'';display:block;width:20px;height:1px;background:#c0d6e8}
  .stepcard h3{font-family:var(--display);font-size:16px;font-weight:700;color:var(--ink);margin-bottom:7px;line-height:1.3}
  .stepcard p{font-size:13.5px;font-weight:300;color:var(--ink-muted);line-height:1.65}

  .btn-link{display:inline-flex;align-items:center;gap:7px;background:var(--accent);color:#fff;border:none;padding:13px 26px;border-radius:var(--radius);font-family:var(--body);font-size:14px;font-weight:500;cursor:pointer;text-decoration:none;transition:background .2s;margin-top:28px}
  .btn-link:hover{background:var(--accent-hover)}
  .btn-link.ghost{background:transparent;border:1px solid var(--accent);color:var(--accent)}
  .btn-link.ghost:hover{background:rgba(43,111,156,0.05)}

  .why{max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
  .why p{font-size:15.5px;font-weight:300;color:var(--ink-muted);line-height:1.8;margin-bottom:14px}
  .why p strong{font-weight:500;color:var(--ink)}
  .why-card{background:#f9fafb;border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;display:flex;gap:13px;align-items:flex-start;margin-bottom:11px}
  .why-card:last-child{margin:0}
  .why-icon{width:34px;height:34px;border-radius:var(--radius);background:var(--blue-light);display:flex;align-items:center;justify-content:center;font-size:17px;flex:none}
  .why-card .t{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:3px}
  .why-card .d{font-size:13px;font-weight:300;color:var(--ink-muted);line-height:1.65}

  .dark{background:var(--blue);padding:80px 48px}
  .dark .section-eyebrow{color:#9fc6e0}
  .dark .section-title{color:#fff}
  .dark .section-sub{color:rgba(255,255,255,0.8)}
  .dark .inner{max-width:1100px;margin:0 auto}
  .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:14px}
  .intro-card{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:var(--radius-lg);padding:30px 26px}
  .intro-card h3{font-family:var(--display);font-size:18px;font-weight:700;color:#fff;margin-bottom:8px}
  .intro-card p{font-size:14px;font-weight:300;color:rgba(255,255,255,0.8);line-height:1.7;margin-bottom:16px}
  .intro-card .btn-link{margin-top:0}

  .faq-list{max-width:760px;margin:0 auto}
  .faq-item{border-bottom:1px solid var(--border);padding:18px 0;cursor:pointer}
  .faq-item:first-child{border-top:1px solid var(--border)}
  .faq-q{display:flex;justify-content:space-between;align-items:center;font-family:var(--display);font-size:16px;font-weight:600;color:var(--ink);gap:14px}
  .faq-q .plus{font-family:var(--mono);font-size:18px;color:var(--accent);transition:transform .2s;flex:none}
  .faq-item.open .faq-q .plus{transform:rotate(45deg)}
  .faq-a{font-size:14px;font-weight:300;color:var(--ink-muted);line-height:1.7;max-height:0;overflow:hidden;transition:max-height .3s ease,margin .3s ease}
  .faq-item.open .faq-a{max-height:200px;margin-top:10px}

  footer{border-top:1px solid var(--border);padding:30px 48px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
  .foot-logo{font-family:var(--display);font-size:17px;font-weight:800;color:var(--blue);opacity:.7}
  .foot-text{font-size:13px;color:var(--ink-light)}

  @media (max-width:768px){
    nav{padding:0 16px}
    .nav-links,.nav-cta{display:none}
    .hamburger{display:flex}
    .hero-wrap{padding:56px 18px 40px}
    .quiz-section{padding:32px 24px 48px}
    .section{padding:56px 18px}
    .dark{padding:56px 18px}
    .steps-grid{grid-template-columns:1fr}
    .why{grid-template-columns:1fr;gap:32px}
    .intro-grid{grid-template-columns:1fr}
    .trust-bar{padding:12px 16px;gap:14px;justify-content:flex-start}
    .trust-item{font-size:12px}
    footer{padding:22px 18px;flex-direction:column;text-align:center}
    .quiz-container{padding:0 8px}
  }
  @media (max-width:380px){.opts.g2{grid-template-columns:1fr}}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto}}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--radius)}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5WCRXXDQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- NAV -->
<nav>
  <div class="nav-logo">
    <img src="rentpal_logo_blue.png" alt="RentPal" onerror="this.style.display='none';document.getElementById('nlogo').style.display='block'">
    <span id="nlogo" style="display:none;font-family:var(--display);font-size:19px;font-weight:700;color:var(--blue)">rentpal</span>
  </div>
  <ul class="nav-links">
    <li><a href="#how">How it works</a></li>
    <li><a href="#why">Why this exists</a></li>
    <li><a href="#intros">If you're moving</a></li>
    <li><a href="#faq">FAQ</a></li>
  </ul>
  <a href="#" onclick="startQuiz();return false;" class="nav-cta">Check my rent</a>
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="#how" onclick="closeMenu()">How it works</a>
  <a href="#why" onclick="closeMenu()">Why this exists</a>
  <a href="#intros" onclick="closeMenu()">If you're moving</a>
  <a href="#faq" onclick="closeMenu()">FAQ</a>
  <a href="#" onclick="startQuiz();closeMenu();return false;" class="mob-cta">Check my rent →</a>
</div>

<!-- HERO (intro CTA) -->
<div id="hero" class="hero-wrap">
  <div class="hero-content">
    <div class="hero-tag"><span style="color:var(--accent);">📍</span> Lagos · Built from real residents</div>
    <h1 class="hero-title">Are you <em>overpaying</em> for rent in Lagos?</h1>
